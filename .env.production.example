# =============================================================================
# Together Forge — PRODUCTION client environment
# =============================================================================
# Copy to host env / CI secrets for the PRODUCTION deploy only.
# Real users and real money live here — keep keys isolated from staging/local.
#
# Isolation model: docs/STAGING_ISOLATION.md
# =============================================================================

# ── Supabase (main production project) ──────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_anon_key

# ── Stripe (LIVE MODE) ──────────────────────────────────────────────────────
# Dashboard → Live mode. Use pk_live_ only in production.
# Confirm checkout/billing Edge Functions use sk_live_ + live webhook secret.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_

# Optional product id from the SAME live Stripe account.
# VITE_STRIPE_PRODUCT_ID=

# Usually omit — defaults to {VITE_SUPABASE_URL}/functions/v1/...
# VITE_STRIPE_CHECKOUT_API_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co/functions/v1/create-checkout
# VITE_STRIPE_BILLING_API_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co/functions/v1

# VITE_STRIPE_PAYMENT_LINKS={}

# ── Server / Edge Function secrets (production project only) ────────────────
# Set via: supabase secrets set --project-ref <PRODUCTION_REF> ...
#
#   STRIPE_SECRET_KEY=sk_live_...              ← LIVE only in production
#   STRIPE_WEBHOOK_SECRET=whsec_...            ← live endpoint signing secret
#   SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
#   SUPABASE_ANON_KEY=...                      ← auto on hosted
#   SUPABASE_SERVICE_ROLE_KEY=...              ← production service_role ONLY
#   MFA_RECOVERY_PEPPER=...                    ← do not share with staging
#
# Never deploy production Edge Functions with sk_test_ or staging Supabase keys.
