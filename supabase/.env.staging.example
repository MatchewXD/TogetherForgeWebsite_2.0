# =============================================================================
# Edge Function secrets — STAGING (reference / checklist)
# =============================================================================
# Do not commit real values. Set on the STAGING Supabase project only:
#   supabase link --project-ref <STAGING_REF>
#   supabase secrets set KEY=value
#
# CRITICAL: never paste production service_role or sk_live_ here.
# Isolation: ../docs/STAGING_ISOLATION.md
# =============================================================================

STRIPE_SECRET_KEY=sk_test_...
# Staging test-mode checkout stays on (unset also defaults on for sk_test_).
ENABLE_DONATIONS=true
# Personal Founder Runway UI (not Stripe). Independent of ENABLE_DONATIONS.
ENABLE_RUNWAY=true
# STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=whsec_...   # Stripe Test mode → webhook for staging URL
# KOFI_WEBHOOK_TOKEN=   # Ko-fi runway verification token (never VITE_)

# Hosted Edge Functions usually get these from the linked project automatically:
# SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # staging project service_role only

# MFA_RECOVERY_PEPPER=unique-staging-pepper
