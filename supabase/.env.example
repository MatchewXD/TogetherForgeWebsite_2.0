# =============================================================================
# Edge Function secrets — LOCAL functions only
# =============================================================================
# Copy to supabase/.env (gitignored). Loaded by `supabase functions serve`.
# Hosted staging/production: use `supabase secrets set` on the matching project.
#
# NEVER put these in Vite client env or prefix with VITE_.
# NEVER use sk_live_ or production service_role for local/staging.
# Isolation: ../docs/STAGING_ISOLATION.md
# =============================================================================

# Stripe TEST mode (local / staging). Production uses sk_live_ on prod project only.
STRIPE_SECRET_KEY=sk_test_replace_me

# LLC Stripe checkout gate (create-checkout + create-token-checkout).
# Does not control Founder Runway. Unset: off for sk_live_, on for test keys.
# ENABLE_DONATIONS=true

# Personal Founder Runway UI (client uses VITE_ENABLE_RUNWAY). Not Stripe.
# ENABLE_RUNWAY=true

# Optional — only if the product exists in THIS Stripe account + mode.
# Leave unset for dynamic tier amounts (recommended).
# STRIPE_PRODUCT_ID=

# From Stripe CLI (`stripe listen`) or Dashboard webhook for THIS environment.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Local functions (hosted projects inject these automatically):
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional — MFA recovery code hashing. Prefer a unique value per environment.
# MFA_RECOVERY_PEPPER=

# ── AI Tokens / Grok (xAI) — Phase 1 foundation ─────────────────────────────
# Required for actual generation in later phases. Status endpoint reports
# provider readiness without exposing the key.
# XAI_API_KEY=
# Optional overrides (use a current model id — grok-2-latest is retired and returns 400):
# Prefer a FAST model for Idea tools so Edge Functions finish under ~40s.
# XAI_MODEL=grok-4-1-fast-non-reasoning
# XAI_IDEA_MODEL=grok-4-1-fast-non-reasoning
# XAI_API_BASE=https://api.x.ai/v1
# AI_PROVIDER=xai
# Internal cost estimate only (micro-USD per token); never shown to users
# AI_EST_MICROS_PER_TOKEN=1

# Optional: private Discord channel webhook for Get Involved applications
# DISCORD_VOLUNTEER_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Report a concern (private email delivery) ───────────────────────────────
# Edge Function: submit-concern-report
# Replace placeholders with real inboxes. Both always receive every report.
# REPORTS_EMAIL=REPORTS_EMAIL_PLACEHOLDER
# FOUNDER_EMAIL=FOUNDER_EMAIL_PLACEHOLDER
# RESEND_API_KEY=
# Optional verified From address (Resend domain). Defaults to Resend onboarding.
# REPORTS_FROM_EMAIL=Together Forge Reports <reports@yourdomain.com>
