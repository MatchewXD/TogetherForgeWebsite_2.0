# =============================================================================
# Edge Function secrets — PRODUCTION (reference / checklist)
# =============================================================================
# Do not commit real values. Set on the PRODUCTION Supabase project only:
#   supabase link --project-ref <PRODUCTION_REF>
#   supabase secrets set KEY=value
#
# Live money: sk_live_ + live webhook only. Never deploy these to staging.
# Isolation: ../docs/STAGING_ISOLATION.md
# =============================================================================

STRIPE_SECRET_KEY=sk_live_...
# Temporary pause while LLC / business banking is completed.
# Unset also stays off on sk_live_. Set true to re-enable live checkout.
ENABLE_DONATIONS=false
# STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=whsec_...   # Stripe Live mode → webhook for production URL

# Hosted Edge Functions usually get these from the linked project automatically:
# SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # production service_role only

# MFA_RECOVERY_PEPPER=unique-production-pepper
