{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com https://*.stripe.com; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.microlink.io https://*.stripe.com https://api.stripe.com; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.png|og-image.jpg|icons.svg|boot.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects/prototype-systems",
      "destination": "/projects/tether",
      "permanent": true
    },
    {
      "source": "/projects/prototype-systems/:path*",
      "destination": "/projects/tether/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ideas/:id([0-9]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|Facebot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Pinterestbot|redditbot|Mastodon|Bluesky|Embedly|Iframely|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/og?type=idea&id=:id"
    },
    {
      "source": "/projects/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|Facebot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Pinterestbot|redditbot|Mastodon|Bluesky|Embedly|Iframely|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/og?type=project&slug=:slug"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
