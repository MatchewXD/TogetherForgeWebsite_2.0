# =============================================================================
# Together Forge — STAGING client environment
# =============================================================================
# Copy to host env / CI secrets for the STAGING deploy only.
# Do not use these values for production. Do not point staging at prod data.
#
# Isolation model: docs/STAGING_ISOLATION.md
#
# CRITICAL — staging must NEVER use:
#   • Stripe live keys (sk_live_ / pk_live_)
#   • Production Supabase URL or keys (anon or service_role)
#   • Production Stripe webhook signing secret
# =============================================================================

# ── Supabase (SEPARATE staging project — not production) ────────────────────
# Create a second Supabase project for staging. Paste its URL + anon key only.
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_staging_anon_key

# ── Stripe (TEST MODE only) ─────────────────────────────────────────────────
# Dashboard → switch to Test mode. Use pk_test_ only.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Staging uses Stripe test keys — keep checkout on so you can still test.
VITE_ENABLE_DONATIONS=true

# Optional product id from the SAME test-mode Stripe account.
# VITE_STRIPE_PRODUCT_ID=

# Usually omit — defaults to {VITE_SUPABASE_URL}/functions/v1/...
# VITE_STRIPE_CHECKOUT_API_URL=https://YOUR_STAGING_PROJECT.supabase.co/functions/v1/create-checkout
# VITE_STRIPE_BILLING_API_URL=https://YOUR_STAGING_PROJECT.supabase.co/functions/v1

# VITE_STRIPE_PAYMENT_LINKS={}

# ── Server / Edge Function secrets (staging project only) ───────────────────
# Set via: supabase secrets set --project-ref <STAGING_REF> ...
# Or document in your host’s secret store for the staging project.
#
#   STRIPE_SECRET_KEY=sk_test_...              ← TEST only, never sk_live_
#   STRIPE_WEBHOOK_SECRET=whsec_...            ← from staging Stripe test webhook
#   SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
#   SUPABASE_ANON_KEY=...                      ← staging anon (auto on hosted)
#   SUPABASE_SERVICE_ROLE_KEY=...              ← staging service_role ONLY
#   MFA_RECOVERY_PEPPER=...                    ← unique per environment preferred
#
# NEVER copy production service_role or sk_live_ into staging.
