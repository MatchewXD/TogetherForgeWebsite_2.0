# =============================================================================
# Together Forge — LOCAL / DEV client environment
# =============================================================================
# Copy to `.env.local` (gitignored) for `npm run dev`.
#
# Isolation model: docs/STAGING_ISOLATION.md
#
# Client vars only below (VITE_*). Secrets never belong in this file.
# Server secrets → supabase/.env (local) or hosted project secrets (staging/prod).
# =============================================================================

# ── Supabase (local CLI default, or a dedicated dev project) ─────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ── Stripe (client / browser only) ──────────────────────────────────────────
# ONLY publishable keys may use VITE_ (pk_test_... for local/dev).
# NEVER put sk_test_, sk_live_, service_role, or webhook secrets here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# LLC only: studio Support, subscriptions, AI Tokens, Stripe checkout.
# Unset: on for pk_test_, off for pk_live_ or a missing key.
# Keep false in production until banking is ready. Does not control Runway.
VITE_ENABLE_DONATIONS=true

# Personal Founder Runway (not Stripe). Independent of VITE_ENABLE_DONATIONS.
# Unset defaults on. Set false to show Coming Soon on Runway only.
VITE_ENABLE_RUNWAY=true

# Optional — leave unset unless you created the product in THIS Stripe account.
# Dynamic $ amounts work without a product id.
# VITE_STRIPE_PRODUCT_ID=

# Optional explicit Edge Function URLs. If empty, client uses:
#   {VITE_SUPABASE_URL}/functions/v1/<function-name>
# VITE_STRIPE_CHECKOUT_API_URL=http://127.0.0.1:54321/functions/v1/create-checkout
# VITE_STRIPE_BILLING_API_URL=http://127.0.0.1:54321/functions/v1

# Optional Payment Links fallback (JSON). Prefer Edge Function checkout.
# VITE_STRIPE_PAYMENT_LINKS={}

# ── Server secrets (DO NOT set here) ────────────────────────────────────────
# Put these only in supabase/.env (local functions) or Supabase secrets (hosted):
#   STRIPE_SECRET_KEY=sk_test_...     ← test mode only for local/dev
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   KOFI_WEBHOOK_TOKEN=              ← Ko-fi runway webhook (never VITE_)
#   SUPABASE_SERVICE_ROLE_KEY=...    ← never VITE_, never in browser
#   SUPABASE_ANON_KEY=...            ← Edge Functions may need this server-side
#   MFA_RECOVERY_PEPPER=...          ← optional, mfa-recovery function
